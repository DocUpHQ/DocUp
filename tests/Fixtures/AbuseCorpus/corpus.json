{
  "$comment": "The abuse corpus. Append only. See README.md. Authored in Phase 00 before any production code.",
  "version": 1,
  "authored": "2026-10-19",
  "cases": [
    {
      "id": "path-001", "category": "path", "defends": "8.9.6",
      "input": "/en/latest/../../../etc/passwd",
      "expect": "400", "note": "classic dot-segment traversal"
    },
    {
      "id": "path-002", "category": "path", "defends": "8.9.6",
      "input": "/en/latest/%2e%2e%2f%2e%2e%2fetc/passwd",
      "expect": "400", "note": "percent-encoded traversal; must be rejected on the raw path, not after decoding"
    },
    {
      "id": "path-003", "category": "path", "defends": "8.9.6",
      "input": "/en/latest/%252e%252e%252fadmin",
      "expect": "400", "note": "double-encoded; a single decode pass would let this through"
    },
    {
      "id": "path-004", "category": "path", "defends": "8.9.6",
      "input": "/en/latest/guide%00.html",
      "expect": "400", "note": "NUL byte truncation"
    },
    {
      "id": "path-005", "category": "path", "defends": "8.9.6",
      "input": "/en/latest/guide\\..\\..\\windows",
      "expect": "400", "note": "backslash as a separator"
    },
    {
      "id": "path-006", "category": "path", "defends": "8.9.6",
      "input": "/en//latest///guide/",
      "expect": "400", "note": "repeated slashes are not byte-canonical; must reject, not normalise-and-serve"
    },
    {
      "id": "path-007", "category": "path", "defends": "8.9.6",
      "input": "//evil.example.com/en/latest/",
      "expect": "400", "note": "protocol-relative path, a redirect-target smuggling vector"
    },
    {
      "id": "path-008", "category": "path", "defends": "8.7.16",
      "input": "/_/x/../../etc/passwd",
      "expect": "400", "note": "traversal through the reserved cross-reference namespace"
    },

    {
      "id": "cache_deception-001", "category": "cache_deception", "defends": "9.3.2",
      "input": "/en/latest/private-page.html/nonexistent.css",
      "expect": "400", "note": "suffix-confusion: a cache keyed on the .css extension would store a private HTML body"
    },
    {
      "id": "cache_deception-002", "category": "cache_deception", "defends": "9.3.2",
      "input": "/en/latest/private-page.html;foo.css",
      "expect": "400", "note": "path-parameter variant of the same attack"
    },
    {
      "id": "cache_deception-003", "category": "cache_deception", "defends": "9.3.2",
      "input": "/en/latest/private-page.html%3Ffoo.css",
      "expect": "400", "note": "encoded query delimiter; rejection must precede the cache lookup"
    },
    {
      "id": "cache_deception-004", "category": "cache_deception", "defends": "8.12.22",
      "input": "GET a known-private asset with no credentials through the real edge",
      "expect": "404-or-403-never-200",
      "note": "the boot-time and CI containment self-test; fails the build on any 200"
    },

    {
      "id": "host-001", "category": "host", "defends": "8.9.3",
      "input": "docs.example.com.evil.net",
      "expect": "404", "note": "look-alike suffix; must not match the verified domain"
    },
    {
      "id": "host-002", "category": "host", "defends": "8.9.3",
      "input": "evildocs.example.com",
      "expect": "404", "note": "prefix look-alike"
    },
    {
      "id": "host-003", "category": "host", "defends": "8.9.3",
      "input": "unknown-host.invalid",
      "expect": "404", "note": "must be a hard 404 and must NOT fall through to a default project"
    },
    {
      "id": "host-004", "category": "host", "defends": "8.10.7",
      "input": "dоcs.example.com",
      "expect": "reject-at-save",
      "note": "Cyrillic o (U+043E) homoglyph; mixed-script confusable"
    },
    {
      "id": "host-005", "category": "host", "defends": "8.10.7",
      "input": "xn--dcs-8cd.example.com",
      "expect": "reject-at-save", "note": "the punycode form of the same confusable"
    },
    {
      "id": "host-006", "category": "host", "defends": "8.9.3",
      "input": "project--version--extra.preview.example.net",
      "expect": "split-on-last-double-hyphen",
      "note": "preview host parsing must split on the LAST '--', not the first"
    },

    {
      "id": "header-001", "category": "header", "defends": "8.9.4",
      "input": "X-DocUp-Project: other-tenant",
      "expect": "ignored", "note": "no trusted project-resolution header exists in any environment (GHSA-mp38-vprc-7hf5 class)"
    },
    {
      "id": "header-002", "category": "header", "defends": "8.9.5",
      "input": "X-Accel-Redirect: /_internal/other-build/html/secret.html",
      "expect": "stripped", "note": "inbound accel header must be stripped at the edge"
    },
    {
      "id": "header-003", "category": "header", "defends": "8.9.8",
      "input": "storage upstream returns X-Accel-Redirect",
      "expect": "ignored", "note": "nginx honours X-Accel-* from ANY upstream; the storage hop must be configured to ignore it"
    },
    {
      "id": "header-004", "category": "header", "defends": "9.3.5",
      "input": "X-Forwarded-For: 1.2.3.4 beyond the trusted hop count",
      "expect": "ignored"
    },
    {
      "id": "header-005", "category": "header", "defends": "8.9.8",
      "input": "a private response handed off by internal redirect",
      "expect": "carries Cache-Control: private, no-store AND Vary: Cookie, each exactly once",
      "note": "ADR 0001: the edge drops the application's headers unless they are re-emitted; this case is the guard"
    },

    {
      "id": "archive-001", "category": "archive", "defends": "8.8.2",
      "builder": "zip_slip", "expect": "contract.path_escapes_root"
    },
    {
      "id": "archive-002", "category": "archive", "defends": "8.8.2",
      "builder": "absolute_symlink", "expect": "contract.symlink_rejected"
    },
    {
      "id": "archive-003", "category": "archive", "defends": "8.8.2",
      "builder": "relative_symlink_escape", "expect": "contract.symlink_rejected"
    },
    {
      "id": "archive-004", "category": "archive", "defends": "8.8.2",
      "builder": "hardlink", "expect": "contract.hardlink_rejected"
    },
    {
      "id": "archive-005", "category": "archive", "defends": "8.8.2",
      "builder": "ratio_bomb", "expect": "contract.compression_ratio_exceeded"
    },
    {
      "id": "archive-006", "category": "archive", "defends": "8.8.2",
      "builder": "reserved_user_ini", "expect": "contract.reserved_filename"
    },
    {
      "id": "archive-007", "category": "archive", "defends": "8.8.2",
      "builder": "reserved_htaccess", "expect": "contract.reserved_filename"
    },
    {
      "id": "archive-008", "category": "archive", "defends": "8.8.2",
      "builder": "php_file", "expect": "contract.reserved_filename"
    },
    {
      "id": "archive-009", "category": "archive", "defends": "8.8.2",
      "builder": "device_node", "expect": "contract.unsupported_entry_type"
    },
    {
      "id": "archive-010", "category": "archive", "defends": "8.8.2",
      "builder": "missing_index", "expect": "contract.missing_html_index"
    },
    {
      "id": "archive-011", "category": "archive", "defends": "8.4.5",
      "builder": "two_pdf_files", "expect": "contract.multiple_pdf_files"
    },
    {
      "id": "archive-012", "category": "archive", "defends": "8.8.2",
      "builder": "overlong_name", "expect": "contract.filename_too_long"
    },

    {
      "id": "redirect-001", "category": "redirect", "defends": "8.11.3",
      "input": [{"from": "/a", "to": "/b"}, {"from": "/b", "to": "/a"}],
      "expect": "reject-at-save", "note": "two-hop cycle, detectable on the literal rule graph"
    },
    {
      "id": "redirect-002", "category": "redirect", "defends": "8.11.3",
      "input": [{"from": "/a", "to": "/b"}, {"from": "/b", "to": "/c"}, {"from": "/c", "to": "/a"}],
      "expect": "reject-at-save", "note": "three-hop cycle"
    },
    {
      "id": "redirect-003", "category": "redirect", "defends": "8.11.3",
      "input": [{"from": "/a/*", "to": "/a/:splat"}],
      "expect": "404-after-hop-cap", "note": "self-referential wildcard; not detectable at save time, must hit the runtime hop cap"
    },
    {
      "id": "redirect-004", "category": "redirect", "defends": "8.11.4",
      "input": {"type": "regex", "pattern": "^(a+)+$"},
      "expect": "reject-at-save", "note": "nested quantifier; catastrophic backtracking"
    },
    {
      "id": "redirect-005", "category": "redirect", "defends": "8.11.4",
      "input": {"type": "regex", "pattern": "(?:(?:(?:a*)*)*)*b"},
      "expect": "reject-at-save"
    },
    {
      "id": "redirect-006", "category": "redirect", "defends": "8.11.2",
      "input": {"type": "exact", "from": "/old", "to": "https://evil.example.com/"},
      "expect": "reject-at-save", "note": "open redirect to an unverified host"
    },

    {
      "id": "config-001", "category": "config", "defends": "8.4.9",
      "builder": "yaml_billion_laughs", "expect": "config.alias_expansion_forbidden"
    },
    {
      "id": "config-002", "category": "config", "defends": "8.4.9",
      "builder": "yaml_depth_40", "expect": "config.max_depth_exceeded"
    },
    {
      "id": "config-003", "category": "config", "defends": "8.4.9",
      "builder": "yaml_256kb_plus", "expect": "config.max_size_exceeded"
    },
    {
      "id": "config-004", "category": "config", "defends": "8.4.8",
      "input": {"version": 2, "project": "other-tenant"},
      "expect": "config.unknown_property",
      "note": "the config file may never name a project; additionalProperties is false"
    },
    {
      "id": "config-005", "category": "config", "defends": "8.4.8",
      "input": {"version": 2, "visibility": "public"},
      "expect": "config.unknown_property",
      "note": "nor visibility - repository content is attacker-controlled"
    },
    {
      "id": "config-006", "category": "config", "defends": "8.4.9",
      "builder": "yaml_multi_document", "expect": "config.single_document_required"
    },

    {
      "id": "git_url-001", "category": "git_url", "defends": "8.3.4",
      "input": "ext::sh -c id", "expect": "reject", "note": "remote code execution via git ext transport"
    },
    {
      "id": "git_url-002", "category": "git_url", "defends": "8.3.4",
      "input": "file:///etc/passwd", "expect": "reject", "note": "local file disclosure"
    },
    {
      "id": "git_url-003", "category": "git_url", "defends": "8.3.4",
      "input": "https://169.254.169.254/latest/meta-data/", "expect": "reject", "note": "cloud metadata"
    },
    {
      "id": "git_url-004", "category": "git_url", "defends": "8.3.4",
      "input": "https://10.0.0.1/internal.git", "expect": "reject", "note": "RFC1918"
    },
    {
      "id": "git_url-005", "category": "git_url", "defends": "8.3.4",
      "input": "https://[::1]/internal.git", "expect": "reject", "note": "IPv6 loopback"
    },
    {
      "id": "git_url-006", "category": "git_url", "defends": "8.3.4",
      "input": "https://[fd00::1]/internal.git", "expect": "reject", "note": "IPv6 ULA"
    },
    {
      "id": "git_url-007", "category": "git_url", "defends": "8.3.4",
      "input": "a TTL-0 DNS name resolving to 127.0.0.1 on second lookup",
      "expect": "reject", "note": "DNS rebinding; resolve-then-pin is the defence"
    },
    {
      "id": "git_url-008", "category": "git_url", "defends": "8.3.4",
      "input": "https://public.example.com/repo.git redirecting to http://10.0.0.1/",
      "expect": "reject", "note": "redirects must be disabled, not followed-then-checked"
    },

    {
      "id": "saml-001", "category": "saml", "defends": "8.12.18",
      "builder": "unsigned", "expect": "reject", "note": "no signature at all"
    },
    {
      "id": "saml-002", "category": "saml", "defends": "8.12.18",
      "builder": "response_signed_assertion_unsigned", "expect": "reject",
      "note": "signature required on Response AND Assertion"
    },
    {
      "id": "saml-003", "category": "saml", "defends": "8.12.18",
      "builder": "signature_wrapping", "expect": "reject",
      "note": "XSW: a signed decoy alongside an unsigned injected assertion"
    },
    {
      "id": "saml-004", "category": "saml", "defends": "8.12.18",
      "builder": "alg_none", "expect": "reject"
    },
    {
      "id": "saml-005", "category": "saml", "defends": "8.12.18",
      "builder": "two_assertions", "expect": "reject", "note": "exactly one Assertion is permitted"
    },
    {
      "id": "saml-006", "category": "saml", "defends": "8.12.18",
      "builder": "wrong_audience", "expect": "reject"
    },
    {
      "id": "saml-007", "category": "saml", "defends": "8.12.18",
      "builder": "wrong_destination", "expect": "reject"
    },
    {
      "id": "saml-008", "category": "saml", "defends": "8.12.18",
      "builder": "expired_notonorafter", "expect": "reject"
    },
    {
      "id": "saml-009", "category": "saml", "defends": "8.12.18",
      "builder": "replayed_assertion_id", "expect": "reject", "note": "the assertion-id replay cache"
    },
    {
      "id": "saml-010", "category": "saml", "defends": "8.12.18",
      "builder": "comment_truncation", "expect": "reject",
      "note": "XML comment in NameID splits the parsed value (CVE-2017-11427 class)"
    },
    {
      "id": "saml-011", "category": "saml", "defends": "8.12.18",
      "builder": "xxe_external_entity", "expect": "reject",
      "note": "must never reach an entity-expanding parser"
    },
    {
      "id": "saml-012", "category": "saml", "defends": "8.12.18",
      "builder": "encrypted_unsigned", "expect": "reject",
      "note": "encrypted assertion without a signature"
    },
    {
      "id": "saml-013", "category": "saml", "defends": "8.12.18",
      "builder": "idp_initiated", "expect": "reject-unless-enabled",
      "note": "IdP-initiated is off by default"
    },
    {
      "id": "saml-014", "category": "saml", "defends": "8.12.18",
      "builder": "clock_skew_130s", "expect": "reject", "note": "skew tolerance is 120s"
    }
  ]
}
