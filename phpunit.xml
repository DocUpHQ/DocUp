<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            🛑 512M, because the architecture suite parses the whole source
            tree.

            Pest's arch presets build an AST for every file in app/ through
            nikic/php-parser, and PHP's default 128M was exhausted once Phase 04
            added the Serving namespace: "Allowed memory size of 134217728 bytes
            exhausted ... in PhpParser/Lexer.php". It failed as a FATAL mid-run
            rather than as a test failure, which reads as a broken suite rather
            than a resource limit.

            Raising it is not lowering a gate (CLAUDE.md rule 4): no threshold
            moves and no assertion is skipped. The work is genuinely larger than
            the default allows, which is why PHPStan is already invoked with a
            1G memory limit of its own for the same reason.

            Scoped here rather than in the Dockerfile so a queue worker and a
            build runner keep the production default.
        -->
        <ini name="memory_limit" value="512M"/>

        <!--
            🛑 APP_ENV, DB_CONNECTION and DB_DATABASE are pinned in
            tests/bootstrap.php, NOT here.

            PHPUnit 13 removed the attribute that made an env element
            overwrite an existing variable, so the elements below cannot
            replace anything the app container or the developer's shell has
            already set - and the container sets both APP_ENV and DB_DATABASE.
            Declared here, they were silently ignored and the suite ran
            against the development database.

            The variables below are ones nothing else sets, so they do take
            effect. DB_HOST stays environment-provided: "db" in the container,
            127.0.0.1 in CI.
        -->
        <env name="DOCUP_APP_HOST" value="docup.test"/>
        <env name="DOCUP_DOCS_APEX" value="docup-docs.test"/>
        <env name="DOCUP_PREVIEW_APEX" value="docup-previews.test"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_HOST" value="db"/>
        <env name="DB_USERNAME" value="docup"/>
        <env name="DB_PASSWORD" value="docup"/>
        <env name="DB_URL" value=""/>
        <!-- A fixed, obviously-fake audit key: the chain tests need a known
             value so a recomputed hash is reproducible across runs. -->
        <env name="DOCUP_AUDIT_KEY" value="test-audit-key-not-a-secret"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
