{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "docup-acme",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "acme-client-secret-for-tests-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://docup.localhost/_/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "engineering"
    },
    {
      "name": "contractors"
    }
  ],
  "users": [
    {
      "username": "reader-at-acme",
      "enabled": true,
      "emailVerified": true,
      "email": "reader@acme.test",
      "firstName": "Acme",
      "lastName": "Reader",
      "requiredActions": [],
      "groups": [
        "/engineering"
      ],
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "acme-reader-password-for-tests-only"
        }
      ]
    }
  ]
}
