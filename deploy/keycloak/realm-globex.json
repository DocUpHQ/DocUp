{
  "realm": "globex",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "docup-globex",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "globex-client-secret-for-tests-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://docup.localhost/_/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "https://docup.localhost/saml/metadata",
      "name": "DocUp (SAML)",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "redirectUris": [
        "https://docup.localhost/_/auth/saml/acs"
      ],
      "attributes": {
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml_name_id_format": "persistent",
        "saml_force_name_id_format": "true",
        "saml.authnstatement": "true",
        "saml_assertion_consumer_url_post": "https://docup.localhost/_/auth/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "single": "false",
            "attribute.name": "groups",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "sales"
    },
    {
      "name": "engineering"
    }
  ],
  "users": [
    {
      "username": "reader-at-globex",
      "enabled": true,
      "emailVerified": true,
      "email": "reader@globex.test",
      "firstName": "Globex",
      "lastName": "Reader",
      "requiredActions": [],
      "groups": [
        "/sales"
      ],
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "globex-reader-password-for-tests-only"
        }
      ]
    }
  ]
}
