# SPDX-License-Identifier: Apache-2.0
#
# SPEC 9.4: level 9 in the namespaces where a type error is a security bug -
# request resolution, authorisation, artifact handling and configuration
# parsing. Run alongside the repo-wide level 8, not instead of it.

includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9

    paths:
        - app/Serving
        - app/Auth
        - app/Artifacts
        - app/Config
        # Phase 05. SPEC 9.4 names serving, authentication, artifact and
        # configuration; source connection is added because a type error in
        # the SSRF deny list or the credential envelope is a security bug by
        # the same argument. Raising a gate is permitted; lowering one is not.
        - app/Egress
        - app/Source
        - app/Credentials
        - app/Logging
        # Phase 06. The build pipeline renders the argv a container runtime
        # executes and carries the one credential that reaches a sandbox,
        # so SPEC 9.4's argument applies with full force: a type error here
        # is a security bug rather than a crash.
        #
        # 🛑 app/Console/Commands is deliberately NOT here. `RunnerCommand`
        # holds the socket, but all of its logic is in app/Builds - the
        # command is a claim loop. Adding the namespace would pull in
        # `doctor` and `install`, which predate this bar by five phases, and
        # raising a gate for code a phase did not touch is how a phase ends
        # up either ignoring findings or growing a second scope.
        - app/Builds
        # Phase 11, and §9.4's argument applies here more plainly than
        # anywhere it has yet been applied. `app/Webhooks` is the
        # application's ONLY unauthenticated write path: a type error in a
        # signature comparison, a replay check or a provider payload is a
        # security bug by construction, not a crash. `app/Automation` joins
        # it because §8.6.15's `delete_version` is the one operation in
        # DocUp that destroys reader-visible URLs.
        - app/Webhooks
        - app/Automation
        # Phase 13. §8.7.7 calls an unchecked component mount "a
        # declassification primitive in a product whose headline feature is
        # per-project authentication", which is §9.4's criterion stated by
        # the requirement itself: a type error in the ceiling comparison is
        # a security bug, not a crash.
        - app/Composition
        - app/Support
        - app/Concerns
        - app/Models
        - app/Http/Middleware

    excludePaths:
        analyseAndScan:
            - vendor

