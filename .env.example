APP_NAME=DocUp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SPEC 11.1: MySQL 8.4 LTS, and only MySQL. The SPEC 9.1 identifier policy is
# built on BINARY(16) keys with BIN_TO_UUID() generated columns, and SPEC 8.16
# search is built on FULLTEXT - neither exists in SQLite, so the skeleton's
# sqlite default is not a lighter option here, it is a broken one.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=docup
DB_USERNAME=docup
DB_PASSWORD=docup

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# SPEC 8.5.22's build-log transport. `null` is the default and the whole of
# the core profile: logs are read by offset polling, which needs no second
# process and no second port. Set this to `reverb` and run
# compose.websocket.yaml to add the optional WebSocket profile.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# DocUp origins (SPEC 8.1.4)
#
# The dashboard and published documentation MUST sit on DISTINCT REGISTRABLE
# DOMAINS, and the application refuses to boot otherwise. Built documentation is
# attacker-controlled JavaScript; on a shared registrable domain it can reach the
# dashboard session. Note that app.example.com and docs.example.com are NOT
# distinct - they share example.com. You need two different registrable domains.
#
# The *.localhost defaults below are three distinct registrable domains and
# resolve to 127.0.0.1 on most systems, so `docker compose up` works unmodified.
###############################################################################
# 🛑 The artifact root MUST match what the edge serves (deploy/Caddyfile and
# deploy/nginx.conf both serve this path). A mismatch makes every documentation
# request a 404 from the edge while the application reports a correct 200, with
# nothing logged as wrong. A test asserts the two agree.
DOCUP_ARTIFACT_ROOT=/var/lib/docup/artifacts

DOCUP_APP_HOST=docup.localhost
DOCUP_DOCS_APEX=docup-docs.localhost
DOCUP_PREVIEW_APEX=docup-previews.localhost
DOCUP_ASSET_HOST=assets.docup-docs.localhost

# Documentation Content-Security-Policy (SPEC 8.14.15, SPEC 8.14.10).
#
# The default policy is three directives and ships on every documentation
# response: `frame-ancestors` (SPEC 8.14.16's per-project branding token,
# defaulting to 'self'), `base-uri 'self'` and `object-src 'none'`. Permissive
# by requirement: SPEC 8.14.15 records that a strict CSP breaks Sphinx inline
# scripts, MathJax and Mermaid, and that shipping one by default "produces a
# flood of bug reports and operators who disable CSP entirely".
#
# Strict mode adds SPEC 8.14.10's img-src/font-src/connect-src set, which kills
# CSS exfiltration. That vector arrives with SPEC 8.14.9's per-project custom
# CSS, which is NOT built (SPEC 18.22's pre-decided consequence), so an
# installation gains nothing from this today and may lose a generator's inlined
# font. Leave it off unless you know why you are turning it on.
# DOCUP_CSP_DOCUMENTATION_STRICT=false

# Unsafe modes (SPEC 8.22.11, 20.4). Every one defaults closed.
# DOCUP_UNSAFE_SINGLE_ORIGIN forces all projects public and disables private
# sharing and tenant CSS. Only set it if you accept SPEC 8.1.5's degraded mode.
DOCUP_UNSAFE_SINGLE_ORIGIN=false
DOCUP_ACKNOWLEDGE_UNSANDBOXED=false
DOCUP_DANGEROUSLY_ALLOW_UNLISTED_AUTH_TYPES=false
DOCUP_ALLOW_RAW_HTML_BRANDING=false
DOCUP_ALLOW_UNVERIFIED_BUILD_IMAGES=false

# Edge driver (SPEC 11.3, ADR 0001): caddy-intercept | nginx-accel
DOCUP_EDGE_DRIVER=caddy-intercept

# Which addresses in front of the application are DocUp's own (SPEC 8.9.4,
# SPEC 8.12.17).
#
# EMPTY is safe and is the default: `X-Forwarded-For` is ignored entirely and
# `$request->ip()` is the direct peer. An installation with no `ip_allowlist`
# binding and no `mtls`/`header_trust` driver needs nothing here.
#
# Accepted values:
#   (empty)       trust nothing
#   *             trust the address directly in front
#   private       trust any RFC1918 / private address
#   a CIDR list   trust exactly those, e.g. 10.4.0.0/24,10.5.0.1
#
# 🛑 `*` is correct ONLY where the application is unreachable except through
# that proxy - the shipped compose topology, where the app port is not
# published. On a host where the application port is reachable, `*` lets any
# client set its own address and the `ip_allowlist` gate compares a value the
# client chose.
#
# 🛑 `X-Forwarded-Host` is trusted NOWHERE, whatever is set here. SPEC 8.9.4:
# "No request header MUST act as a project, version or tenant selector, in any
# environment." The project comes from the Host and the path.
DOCUP_TRUSTED_PROXIES=

# Which driver types may be configured (SPEC 8.12.4). Comma-separated; EMPTY
# means every registered type, which is the default.
#
# 🛑 `header_trust` is the exception in both directions: SPEC 8.12.17 marks it
# "off by default", so it must be NAMED here. Neither the permissive default
# nor DOCUP_DANGEROUSLY_ALLOW_UNLISTED_AUTH_TYPES reaches it.
DOCUP_PERMITTED_AUTH_TYPES=

# SPEC 8.12.17's `header_trust`: an identity the TLS terminator asserts.
#
# 🛑 BOTH headers are required and the driver's probe fails without either, so
# a binding cannot be activated half-configured. A terminator that sets the
# subject header only for an AUTHENTICATED reader passes an unauthenticated
# reader's own header through untouched - oauth2-proxy's default - so the
# subject header alone is forgeable with one curl. The shared secret is what
# distinguishes the terminator's assertion from a client's copy of it.
#
# Set the secret at the terminator and seal the same value on the binding:
#   proxy_set_header X-DocUp-Assertion "<the binding's assertion_secret>";
#
# 🛑 And set the subject header UNCONDITIONALLY - to an empty value for an
# unauthenticated reader - with `proxy_set_header` (nginx) or `header_up`
# (Caddy), never `header_up +`. A header DocUp receives twice is refused
# outright, because one of the two values is the client's.
DOCUP_ASSERTED_SUBJECT_HEADER=
DOCUP_ASSERTED_SECRET_HEADER=

# SPEC 8.12.17's `mtls`: a client certificate the TLS terminator verified.
#
# 🛑 The verdict header is required, and the bypass it closes is worth
# knowing: nginx's `ssl_verify_client optional` forwards
# `$ssl_client_escaped_cert` EVEN WHEN VERIFICATION FAILED. Reading only the
# certificate would accept a self-signed one an attacker minted with the right
# issuer DN, because the issuer DN is a field in a document the attacker wrote.
#
#   proxy_set_header X-Client-Verify $ssl_client_verify;   # nginx
#   header_up X-Client-Verify SUCCESS                      # Caddy, inside a
#                                                          # require_and_verify route
#
# FORMAT names how the terminator spells a certificate in a header, and it is
# stated rather than sniffed: escaped_pem | pem | der_base64. nginx's
# `$ssl_client_escaped_cert` is escaped_pem; Caddy's and HAProxy's base64 DER
# is der_base64.
DOCUP_CLIENT_CERTIFICATE_HEADER=
DOCUP_CLIENT_CERTIFICATE_FORMAT=escaped_pem
DOCUP_CLIENT_CERTIFICATE_VERDICT_HEADER=
DOCUP_CLIENT_CERTIFICATE_VERDICT_SUCCESS=SUCCESS


# TLS automation (SPEC 8.10.10 - 8.10.21)
#
# Published ports. 443 is where readers arrive; 🛑 80 must stay published too,
# because an ACME http-01 validation reaches a hostname that has no certificate
# yet (SPEC 8.10.18). Closing 80 makes every public issuance fail at the CA with
# nothing logged on this side.
DOCUP_HTTP_PORT=8080
DOCUP_HTTPS_PORT=8443

# 🛑 SPEC 8.10.12: this MUST NOT be https on a hostname this installation
# serves. That configuration is an unrecoverable startup deadlock — the proxy
# cannot reach the endpoint without a certificate and cannot get a certificate
# without the endpoint — so the application refuses to boot on it rather than
# discovering it at the first handshake, where nothing is logged.
DOCUP_TLS_PERMISSION_ENDPOINT=http://127.0.0.1/_/edge/tls-permission
DOCUP_TLS_CERTIFICATE_ENDPOINT=http://127.0.0.1/_/edge/certificate

# SPEC 8.10.8's A/AAAA advice and SPEC 8.10.11's live-DNS check: the public
# addresses readers reach this installation at, comma-separated.
#
# Empty by default and that is honest — DocUp cannot discover its own public
# address, and guessing it from a request would print whatever the last proxy
# hop happened to be. Where it is unset, the documentation apex is resolved
# instead, which is what every CNAME in SPEC 8.10.8 points at anyway. Set it and
# you also get the A-record instructions SPEC 8.10.8 calls "a genuine advantage
# over Read the Docs".
DOCUP_INGRESS_ADDRESSES=

# SPEC 8.10.14's ACME account. Empty by default: SPEC 8.10.11's design has the
# proxy obtain a custom domain's public certificate on demand, so most
# installations configure nothing here. Set a directory URL to have DocUp hold
# the key instead — an internal step-ca or Vault for an air-gapped installation,
# or a public CA. 🛑 Nothing is auto-registered: SPEC 18.20 requires an
# operator-supplied account, because an ACME account is an agreement to terms
# and a rate budget that is yours to spend.
DOCUP_ACME_DIRECTORY=
DOCUP_ACME_CONTACT=
DOCUP_ACME_KIND=public

# SPEC 8.10.13 counts issuance "per registered domain", which needs the Public
# Suffix List. DocUp does not bundle it — a stale copy is a silently wrong rate
# limiter — and uses the last two labels instead, which over-groups a
# multi-label suffix such as co.uk and therefore blocks EARLIER than the CA
# would. Wrong in the safe direction. Name the suffixes you serve under to get
# the CA's own bucketing back: DOCUP_PUBLIC_SUFFIXES=co.uk,com.au
DOCUP_PUBLIC_SUFFIXES=

# Search (SPEC 8.16.1, ADR 0004): mysql_fulltext | meilisearch
#
# The default needs no service. SPEC 8.16.2's limits are real and stated on each
# project's Search page: no stemming, no typo tolerance, a three-character
# minimum indexed word, 36 stopwords. A search for `go` returns NOTHING, because
# two characters are not in the index at all.
#
# SPEC 8.16.1 recommends Meilisearch above a measured 200,000 sections, and
# `docup:doctor` warns at the threshold. The reason is SPEC 8.16.6's
# measurement: the filtered query every real search runs costs p95 80 ms against
# 10 ms unfiltered at that size, and the cost grows with how many sections MATCH
# rather than with how many results are asked for.
DOCUP_SEARCH_DRIVER=mysql_fulltext

# Meilisearch, when DOCUP_SEARCH_DRIVER=meilisearch. Blank otherwise and the
# default driver ignores all four.
#
# 🛑 The URL is INSTALLATION configuration, in the same class as DB_HOST, which
# is why App\Egress\MeilisearchTransport takes a path rather than a URL: nothing
# a tenant, a project or a reader supplies can influence where it connects.
#
# 🛑 The key never leaves the application process. SPEC 8.12.21 forbids a
# search-engine token reaching a browser — a Meilisearch tenant token is a plain
# HS256 JWT a browser can read and that cannot be revoked before it expires — so
# DocUp mints none and proxies every search server-side (SPEC 8.16.6). This is
# the only search key in the system.
#
# 🛑 Adding a filterable attribute later would force Meilisearch to reindex
# everything (SPEC 8.16.8), so DocUp declares the complete set on the first
# pass. If a release ever needs a new one it will say so and refuse until you
# reindex deliberately.
DOCUP_MEILISEARCH_URL=
DOCUP_MEILISEARCH_KEY=
DOCUP_MEILISEARCH_INDEX=docup_search
DOCUP_MEILISEARCH_TIMEOUT=5

# Telemetry (SPEC 8.22.12): off by default, opt-in, aggregate only.
DOCUP_TELEMETRY=false
DOCUP_ADVISORY_CHECK=false

# 🛑 SPEC 8.22.1: the audit-chain key, held OUTSIDE APP_KEY.
#
# Whoever holds this can forge an audit chain that verifies, so it is kept
# apart from the key the application needs for everyday work. `docup:install`
# generates one; to do it by hand:
#
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Back it up separately from APP_KEY. Losing it does not destroy the log, but
# it ends your ability to prove the log was not altered.
DOCUP_AUDIT_KEY=

# ------------------------------------------------------------------------------
# The build sandbox (SPEC 8.5.8-8.5.12, 8.5.18, 8.1.7)
# ------------------------------------------------------------------------------

# 🛑 SPEC 8.5.11: there is NO DEFAULT, deliberately. Production boot is refused
# with builds enabled and this unset, because documentation builds execute code
# from the repositories you connect and the choice of what separates that code
# from this host is not one DocUp will make on your behalf.
#
#   gvisor  the documented production recommendation. Needs Linux 5.6+ and
#           `runsc` registered as a Docker runtime. gVisor does not implement
#           the whole Linux system-call surface, so some generators and their
#           native extensions fail under it - which is why it is not the
#           default (SPEC 19/23).
#   runc    hardened runc: every capability dropped, no-new-privileges, a
#           read-only root, noexec tmpfs, PID/memory/CPU limits and no swap.
#           Supported, and it shares this host kernel with every repository
#           you build.
DOCUP_BUILD_ISOLATION=runc

# SPEC 8.5.9. `allowlist` is the shipped default: the sandboxes network, the
# nftables backstop and one CONNECT proxy whose host list is
# deploy/egress-allowlist.conf. `none` is STRICTER (no network at all, which
# works when every toolchain is pre-baked). `open` is weaker than both and,
# with runc, requires DOCUP_ACKNOWLEDGE_UNSANDBOXED=true.
DOCUP_SANDBOX_EGRESS=allowlist

# 🛑 SPEC 8.1.7's hosting-only mode. With this false no repository code runs
# anywhere: documentation enters exclusively through the direct-upload API and
# a build trigger is refused with a stable identifier rather than queued for a
# runner that will never arrive. This is the configuration a security team
# adopts when it wants the RCE surface removed and builds running in its own CI.
DOCUP_BUILDS_ENABLED=true

# SPEC 8.5.18's per-build limits. The disk limit is enforced by measurement
# from the runner rather than by a filesystem quota - see `Workspace` and
# ADR 0011 for the two kernel-enforced alternatives that were measured and
# refused on an ordinary host.
DOCUP_BUILD_WALL_CLOCK=1800
DOCUP_BUILD_MEMORY_MB=4096
DOCUP_BUILD_CPUS=1
DOCUP_BUILD_PIDS=512
DOCUP_BUILD_DISK_MB=2048

# Where build workspaces live ON THE HOST. The runner bind-mounts this at the
# same path so it can measure a build's disk use while the build runs.
DOCUP_WORKSPACE_ROOT=/var/lib/docup/workspaces

# SPEC 8.5.5. `simple` is arrival order across the installation; `fair` adds
# deficit round-robin between organisations, weighted by `organisations.build_share`.
DOCUP_ADMISSION=simple
